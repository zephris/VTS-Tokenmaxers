# Leave STEGANOGRAPHY_MODEL_COMMAND unset to run the API without the model.
PORT=3001
STEGANOGRAPHY_MODEL_COMMAND=python3
STEGANOGRAPHY_MODEL_ARGS=["conversationstenography/python/hf_model.py","--model","gpt2","--device","cpu","--dtype","float32"]

# These protocol settings must be identical for every participant.
STEGANOGRAPHY_PROMPT=The weather today is
STEGANOGRAPHY_CHAIN_SYSTEM=
STEGANOGRAPHY_TOP_N=8
STEGANOGRAPHY_CODING=arithmetic
STEGANOGRAPHY_TEMPERATURE=1
STEGANOGRAPHY_FINISH_TOKENS=32
STEGANOGRAPHY_STRICT_STYLE=true
STEGANOGRAPHY_CANDIDATE_POOL=8
STEGANOGRAPHY_REFRESH_SENTENCES=false
STEGANOGRAPHY_CARRIER_TRIALS=2
STEGANOGRAPHY_NATURALNESS_SLACK=0.35
STEGANOGRAPHY_SEMANTIC_JUDGE=false
STEGANOGRAPHY_SEMANTIC_THRESHOLD=-6
STEGANOGRAPHY_LENGTH_BIAS=0.1
