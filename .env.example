# Reference copy. The Go server reads apps/server/.env by default.
PORT=3001
DATABASE_PATH=./data/silent-outposts.db
DATASET_ARCHIVE_PATH=./data/source/sunken-garden-and-cs-building.zip
CORS_ALLOWED_ORIGINS=http://localhost:5173
STATION_ACCOUNT_DEFAULT_PASSWORD=station-demo
STATION_SESSION_HOURS=12

# The dashboard and deterministic incident-analysis stub work while this is false.
STEGANOGRAPHY_ENABLED=false
STEGANOGRAPHY_MODEL_COMMAND=./.venv/bin/python
STEGANOGRAPHY_MODEL_ARGS=["conversationstenography/python/hf_model.py","--model","gpt2","--revision","main","--device","cpu","--dtype","float32"]

# Every participant must use identical model and protocol settings.
STEGANOGRAPHY_PROMPT=The weather today is
STEGANOGRAPHY_CHAIN_SYSTEM=
STEGANOGRAPHY_TOP_N=8
STEGANOGRAPHY_CODING=arithmetic
STEGANOGRAPHY_TEMPERATURE=1
STEGANOGRAPHY_FINISH_TOKENS=32
STEGANOGRAPHY_STRICT_STYLE=true
STEGANOGRAPHY_CANDIDATE_POOL=8
STEGANOGRAPHY_REFRESH_SENTENCES=false
STEGANOGRAPHY_CARRIER_TRIALS=2
STEGANOGRAPHY_NATURALNESS_SLACK=0.35
STEGANOGRAPHY_SEMANTIC_JUDGE=false
STEGANOGRAPHY_SEMANTIC_THRESHOLD=-6
STEGANOGRAPHY_LENGTH_BIAS=0.1

# Optional browser override. Empty uses Vite's /api proxy.
VITE_API_BASE_URL=
