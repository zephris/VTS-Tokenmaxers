# Server
PORT=3001
DATABASE_PATH=./data/silent-outposts.db

# Dataset import. Defaults to hackathon/dataset relative to the server package.
DATASET_DIR=

# Server mode. The server is dataset-only (never loads or launches an LLM) unless
# STEGANOGRAPHY_ENABLED=true. In dataset-only mode /api/ai/incident-summary returns 403.
STEGANOGRAPHY_ENABLED=

# Vercel AI SDK / OpenAI provider (only used when STEGANOGRAPHY_ENABLED=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Frontend (optional; defaults to the Vite proxy)
VITE_API_BASE_URL=
